generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  title            String
  location         String
  workType         String
  experience       String
  salary           String
  description      String
  qualifications   String[] @default([])
  responsibilities String[] @default([])
  contactEmail     String
  contactPhone     String
  createdAt        DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  message   String
  createdAt DateTime @default(now())
}
