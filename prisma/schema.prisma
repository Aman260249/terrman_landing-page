generator client {
  provider = "prisma-client"
  previewFeatures = ["driverAdapters"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
 

}




model Job {
  // Use dbgenerated to tell Supabase/Postgres to create the ID
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  title            String
  location         String
  workType         String
  experience       String
  salary           String
  description      String
  qualifications   String[] @default([])
  responsibilities String[] @default([])
  contactEmail     String
  contactPhone     String
  createdAt        DateTime @default(now())
} 



model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  message   String
  createdAt DateTime @default(now())
}